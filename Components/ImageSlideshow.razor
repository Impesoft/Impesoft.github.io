<div class="slideshow-container">
    @for (int i = 1; i <= ImageCount; i++)
    {
        int index = i;
        var isActive = index == currentSlideIndex ? "active" : "";
        <div class="slide @isActive" @onclick="() => OnImageClick.InvokeAsync((ImageFolder, ImageCount, index))" style="cursor: pointer;" title="Click to enlarge">
            <img src="assets/img/projects/@ImageFolder/screenshot_@(index).png" alt="Screenshot @index" loading="lazy" />
        </div>
    }

    @if (ImageCount > 1)
    {
        <button class="slide-btn prev" @onclick="PrevSlide" @onclick:preventDefault aria-label="Previous image">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button class="slide-btn next" @onclick="NextSlide" @onclick:preventDefault aria-label="Next image">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
        <div class="slide-dots">
            @for (int i = 1; i <= ImageCount; i++)
            {
                int dotIndex = i;
                <span class="dot @(dotIndex == currentSlideIndex ? "active" : "")" @onclick="() => SetSlide(dotIndex)"></span>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string ImageFolder { get; set; } = string.Empty;

    [Parameter]
    public int ImageCount { get; set; } = 0;

    [Parameter]
    public EventCallback<(string Folder, int Count, int Index)> OnImageClick { get; set; }

    private int currentSlideIndex = 1;

    private void NextSlide()
    {
        currentSlideIndex++;
        if (currentSlideIndex > ImageCount)
        {
            currentSlideIndex = 1;
        }
    }

    private void PrevSlide()
    {
        currentSlideIndex--;
        if (currentSlideIndex < 1)
        {
            currentSlideIndex = ImageCount;
        }
    }

    private void SetSlide(int index)
    {
        currentSlideIndex = index;
    }
}
